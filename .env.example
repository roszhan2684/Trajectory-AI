# Trajectory AI — environment variables.
# The demo build runs with NONE of these set: every external system is replaced by a clearly
# labeled local adapter (see Settings → Integrations). Variables marked [hosted] document the
# production integration points from the build spec; they are reported, never faked as connected.

# ---- App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required in production (≥ 32 chars). Signs session cookies and candidate-portal links.
SESSION_SECRET=
# Where the demo store is persisted (default: apps/web/.data). Read-only filesystems fall back to memory.
TRAJECTORY_DATA_DIR=
# Delay between job steps so progress is visible in the UI (demo pacing). 0 = no delay.
DEMO_STEP_DELAY_MS=350
# Allow "Reset demo data" on a production deployment (off by default).
TRAJECTORY_ALLOW_DEMO_RESET=

# ---- [hosted] Supabase (auth + Postgres)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# ---- [hosted] Typesense
TYPESENSE_HOST=
TYPESENSE_PORT=
TYPESENSE_PROTOCOL=
TYPESENSE_SEARCH_ONLY_API_KEY=
TYPESENSE_ADMIN_API_KEY=

# ---- [hosted] LLM providers — NOT used. Models are trained from scratch (ml/train.py) and run locally.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- [hosted] Langfuse, Trigger.dev, PostHog, Sentry, email
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
TRIGGER_SECRET_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_AUTH_TOKEN=
SENTRY_DSN=
RESEND_API_KEY=

# ---- MCP server (apps/mcp)
TRAJECTORY_API_URL=http://localhost:3000
TRAJECTORY_API_KEY=trj_demo_jordan
